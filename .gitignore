# ==============================================================================
# CivicPulse AI — Root .gitignore
# ==============================================================================

# Virtual Environment & Dependencies
backend/venv/
backend/env/
frontend/node_modules/

# Production Build Output
frontend/dist/
frontend/dist-ssr/
build/
dist/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# SQLite Database & Runtime Data
# Note: Keep local SQLite database uncommitted to prevent merge conflicts
# and binary churn. Seed data can be initialized or seeded upon setup.
*.db
*.sqlite
*.sqlite3

# Secrets, Environment & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Scratch & Temporary Testing Scripts
scratch/
